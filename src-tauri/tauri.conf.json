{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FloatNote",
  "version": "0.1.1",
  "identifier": "com.pocari.floatnote",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FloatNote",
        "width": 420,
        "height": 560,
        "minWidth": 240,
        "minHeight": 160,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
